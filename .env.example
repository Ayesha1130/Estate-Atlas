# ==============================================================================
# PROPERTYHUB PREMIER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# ==============================================================================

# Supabase Project URL and Public Anonymous Key (Required)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Secret Key (Required for server-side admin endpoints & migrations)
# Found in: Supabase Dashboard > Project Settings > API > service_role secret
# CAUTION: Never prefix this with NEXT_PUBLIC_ or expose it to client browsers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# OpenAI API Key (Required for AI Concierge & Semantic Embeddings)
# Get from: https://platform.openai.com/api-keys
# Note: If omitted or invalid, PropertyHub Premier falls back gracefully to
# an intelligent local regex and heuristic real estate parser with full uptime.
OPENAI_API_KEY=sk-proj-...

# Application Domain URL (Used for SEO metadata, OpenGraph, and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis REST Credentials (OPTIONAL)
# If provided, rate limiting is handled via Upstash Redis pipelines.
# If omitted, PropertyHub Premier automatically falls back to database RPC
# in production or safe bounded in-memory sliding-window maps in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
